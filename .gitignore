# .gitignore

# Environment variables & local configuration
.env
.env.*
!.env.example

# Virtual environments
venv/
.venv/
env/
ENV/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class

# Database
chatbot.db
*.db
*.sqlite
*.sqlite3

# IDE & Editor configs
.vscode/
.idea/
*.swp
*.swo

# Testing & Linting
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Logs
*.log
logs/

# OS generated files
.DS_Store
Thumbs.db